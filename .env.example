# Copia este archivo a .env y completa los valores
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=TU_SUPABASE_KEY
SUPABASE_TABLE=linkedin_results
APP_ROLE=full

# Opcional (si no defines Supabase, se usará SQLite local)
SQLITE_PATH=/Users/erick/github/JobsOn/data/jobson.db

WEB_HOST=127.0.0.1
WEB_PORT=5050

# --- Publicación a WordPress (WP Job Manager + Cariera, ej. erecruit.ca) ---
# Genera la Application Password en WP-Admin → Users → Tu Perfil → Application Passwords.
WP_BASE_URL=https://staging.erecruit.ca
WP_USER=tu_usuario_admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WP_DEFAULT_STATUS=draft
WP_EXPIRES_DAYS=30

# --- IA para normalizar descripciones (OpenRouter, opcional) ---
# Si OPENROUTER_API_KEY está vacío, la normalización cae al regex local.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_TIMEOUT=45

# --- Flask sessions (genera uno con: python3 -c "import secrets; print(secrets.token_urlsafe(48))") ---
FLASK_SECRET_KEY=
